#!/usr/bin/env python3
"""Deterministic fake generic command worker (transport: command).

Writes ONLY the turn artifact. It also prints a self-claimed identity
JSON to stdout — which the adapter must IGNORE: a worker's own output
is never identity proof. Evidence comes from the separately configured
external verifier (see fake-verifier).

Usage: fake-worker --task T --turn-output O --round R --actor A
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _fakelib  # noqa: E402

if __name__ == "__main__":
    parser = argparse.ArgumentParser(prog="fake-worker")
    parser.add_argument("--task", required=True)
    parser.add_argument("--turn-output", required=True)
    parser.add_argument("--round", required=True)
    parser.add_argument("--actor", required=True)
    args = parser.parse_args()

    _fakelib.mark_spawn("worker")
    _fakelib.forced_exit()

    seed_value = _fakelib.seed(args.actor, args.round)
    turn_text = (
        f"# {args.round} by {args.actor}\n\n"
        f"Deterministic fake worker turn (seed {seed_value}).\n\n"
        f"{_fakelib.body(seed_value)}\n"
    )
    turn_path = Path(args.turn_output)
    turn_path.parent.mkdir(parents=True, exist_ok=True)
    turn_path.write_text(turn_text, encoding="utf-8")

    # Self-claimed identity: deliberately untrustworthy noise.
    print(json.dumps({
        "self_reported": True,
        "claimed_model": "definitely-a-frontier-model",
        "note": "self-reported output is not identity proof",
    }))
    raise SystemExit(0)
